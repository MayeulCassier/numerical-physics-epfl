tfin = 2
nsteps = 2
output = output.out
sampling = 1
N_part = 1000 // number of particles
N_bins = 100 // number of bins for reconstructing the distribution function
v0 = 0
gamma = 0.2
D = 0.3 
vhb = 1 // upper velocity boundary for f binning
vlb = -1 // lower velocity boundary for f binning
vg_D = -4 // low velocity value for  initial Dirac distribution (or for uniform distribution)
vd_D = 4 // high velocity value for  initial Dirac distribution (or for uniform distribution)
sigma0=0.1
vc = 3 
initial_distrib = G // D to use as initial distribution the sum of two Dirac distribution
